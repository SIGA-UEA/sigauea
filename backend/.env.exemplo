# Copie para backend/.env e preencha. O backend/.env fica fora do git (tem senha).
# Sem SMTP_HOST, os e-mails só aparecem no terminal da API.

# E-mail (Gmail: use uma "senha de app", não a senha da conta)
SMTP_HOST=smtp.gmail.com
SMTP_PORTA=587
SMTP_USUARIO=conta@gmail.com
SMTP_SENHA=
EMAIL_REMETENTE=SIGA UEA <conta@gmail.com>

# Endereço do site, usado nos links dos e-mails
FRONTEND_URL=http://localhost:3000
