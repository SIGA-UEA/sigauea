 id="p1-app.routes.turmas" value="&lt;i&gt;«controle»&lt;/i&gt;&lt;br&gt;&lt;b&gt;ControladorTurmas&lt;/b&gt;" style="swimlane;html=1;whiteSpace=wrap;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=46;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="58" y="1216" width="878" height="202" as="geometry"/></mxCell><mxCell id="p1-app.routes.turmas-s0" value="+ GET /periodos → listar_periodos() : list[PeriodoOut] [autenticado]&#10;+ POST /periodos → criar_periodo(dados: PeriodoCriar) : PeriodoOut 201 [coordenador]&#10;+ GET /turmas → listar_turmas(periodo?) : list[TurmaOut] [coordenador]&#10;+ GET /turmas/minhas → minhas_turmas() : list[TurmaCartao] [autenticado]&#10;+ POST /turmas → criar_turma(dados: TurmaCriar) : TurmaOut 201 [coordenador]&#10;+ GET /turmas/{turma_id} → obter_turma(turma_id) : TurmaOut [autenticado]&#10;+ POST /turmas/{turma_id}/alunos → incluir_aluno(turma_id, dados: MatriculaCriar) : TurmaOut 201 [coordenador]&#10;+ PATCH /turmas/{turma_id}/alunos/{matricula_id} → alterar_situacao(turma_id, matricula_id, dados: MatriculaAtualizar) : TurmaOut [coordenador]" style="text;strokeColor=none;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=0;fontFamily=Courier New;fontSize=10;" vertex="1" parent="p1-app.routes.turmas"><mxGeometry y="46" width="878" height="120" as="geometry"/></mxCell><mxCell id="p1-app.routes.turmas-s1" value="tag OpenAPI: turmas&#10;infra: database, deps, models, schemas.tcc" style="text;strokeColor=#82b366;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=0;fontFamily=Courier New;fontSize=10;" vertex="1" parent="p1-app.routes.turmas"><mxGeometry y="166" width="878" height="36" as="geometry"/></mxCell><mxCell id="p1-ap