 parent="p3-UsuarioOut.curso-&gt;CursoOut"><mxGeometry x="-0.9465" relative="1" as="geometry"><mxPoint x="0" y="8" as="offset"/></mxGeometry></mxCell><mxCell id="p3-UsuarioOut.areas-&gt;AreaOut" value="" style="edgeStyle=none;rounded=0;html=1;endFill=1;startFill=0;endArrow=diamondThin;endSize=14;startArrow=open;startSize=10;strokeColor=#333333;exitX=1.0000;exitY=0.7500;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.3320;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p3-AreaOut" target="p3-UsuarioOut"><mxGeometry relative="1" as="geometry"><mxPoint x="1303" y="1361" as="sourcePoint"/><mxPoint x="1874" y="1278" as="targetPoint"/><Array as="points"><mxPoint x="1818" y="1361"/><mxPoint x="1818" y="1278"/></Array></mxGeometry></mxCell><mxCell id="p3-UsuarioOut.areas-&gt;AreaOut-l0" value="*" style="edgeLabel;html=0;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=9;fontColor=#333333;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="p3-UsuarioOut.areas-&gt;AreaOut"><mxGeometry x="-0.9673" relative="1" as="geometry"><mxPoint x="0" y="8" as="offset"/></mxGeometry></mxCell><mxCell id="p3-UsuarioOut.areas-&gt;AreaOut-l1" value="areas" style="edgeLabel;html=0;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=9;fontColor=#333333;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="p3-UsuarioOut.areas-&gt;AreaOut"><mxGeometry x="-0.0911" relative="1" as="geometry"><mxPoint x="0" y="10" as="offset"/></mxGeometry></mxCell><mxCell id="p3-leg" value='&lt;b&gt;Cores&lt;/b&gt;&lt;br&gt;&lt;font color="#b85450"&gt;■&lt;/font&gt; «DTO»: formato de entrada ou saída da API&lt;br&gt;&lt;font color="#d6b656"&gt;■&lt;/font&gt; Tipos e constantes usados nos campos&lt;br&gt;&lt;br&gt;&lt;b&gt;Onde está no código&lt;/b&gt;&lt;br&gt;Cada DTO é a classe de mesmo nome em backend/app/schemas/ (TccOut está em tcc.py;&lt;br&gt;    LoginEntrada em auth.py; UsuarioOut em usuario.py)&lt;br&gt;TiposTcc = tipos e constantes do topo de schemas/tcc.py (idem TiposAuth, TiposUsuario)&lt;br&gt;&lt;br&gt;&lt;b&gt;Conteúdo&lt;/b&gt;&lt;br&gt;Campos exatamente como declarados (tipo, restrições e padrão)&lt;br&gt;«field_validator»: validação extra do campo&lt;br&gt;Losango: um DTO dentro de outro (TccOut.aluno é um PessoaOut)&lt;br&gt;    nome do campo no meio da linha; na ponta, list = * e | None = 0..1&lt;br&gt;&lt;br&gt;&lt;b&gt;Notação UML&lt;/b&gt;&lt;br&gt;Linha contínua: associação; seta aberta no lado navegável&lt;br&gt;Losango cheio: composição (a parte não existe sem o todo)&lt;br&gt;Triângulo vazio: herança&lt;br&gt;Linha tracejada com seta: dependência («usa»)&lt;br&gt;Na ponta: multiplicidade (1 = um, 0..1 = zero ou um, * = vários)&lt;br&gt;No meio da linha: papel, quando não repete o nome da classe (ex.: professor)' style="text;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#fafafa;strokeColor=#999999;rounded=1;arcSize=2;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="3426" y="70" width="470" height="405" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="5 · Planejado (fora do código)" id="classes-4"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4976" pageHeight="2318" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p4-t" value="SIGA UEA · Diagrama de classes · planejado (ainda NÃO está no código)" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1600" height="36" as="geometry"/></mxCell><mxCell id="p4-novo-aluno" value="&lt;i&gt;«planejada · MOD01»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Aluno (colunas novas)&lt;/b&gt;" style="swimlane;html=1;whiteSpace=wrap;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=46;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;f