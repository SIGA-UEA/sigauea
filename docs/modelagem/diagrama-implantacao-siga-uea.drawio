<mxfile host="app.diagrams.net"><diagram name="1 · Ambiente integrado (Vercel, Render e Neon)" id="impl-0"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2220" pageHeight="1136" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="i0-t" value="SIGA UEA · Diagrama de implantação · Ambiente integrado: Vercel (site), Render (API), Neon (banco) e Brevo (e-mail)" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="1500" height="34" as="geometry"/></mxCell><mxCell id="i0-cli" value='&lt;font color="#555555" style="font-size:9px"&gt;«device»&lt;/font&gt;&lt;br&gt;&lt;b&gt;Computador ou celular do usuário&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9.5px"&gt;aluno, docente, coordenação e banca&lt;br&gt;(inclusive externos) · visitante da&lt;br&gt;agenda pública (RAN14)&lt;/font&gt;' style="shape=cube;size=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;spacingRight=8;container=1;collapsible=0;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="260" height="240" as="geometry"/></mxCell><mxCell id="i0-nav" value='&lt;font color="#555555" style="font-size:9px"&gt;«executionEnvironment»&lt;/font&gt;&lt;br&gt;&lt;b&gt;Navegador web&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9.5px"&gt;Chrome ou Safari, a partir de 360 px&lt;/font&gt;' style="shape=cube;size=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;spacingRight=8;container=1;collapsible=0;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="i0-cli"><mxGeometry x="20" y="95" width="220" height="130" as="geometry"/></mxCell><mxCell id="i0-ui" value='&lt;font color="#666666" style="font-size:9px"&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;Interface SIGA&lt;/b&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="i0-nav"><mxGeometry x="15" y="60" width="190" height="55" as="geometry"/></mxCell><mxCell id="i0-git" value='&lt;font color="#555555" style="font-size:9px"&gt;«device»&lt;/font&gt;&lt;br&gt;&lt;b&gt;GitHub&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9.5px"&gt;repositório SIGA-UEA/sigauea&lt;/font&gt;' style="shape=cube;size=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;spacingRight=8;container=1;collapsible=0;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="260" height="150" as="geometry"/></mxCell><mxCell id="i0-repo" value='&lt;font color="#666666" style="font-size:9px"&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;código da branch main&lt;/b&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="i0-git"><mxGeometry x="20" y="70" width="220" height="60" as="geometry"/></mxCell><mxCell id="i0-mon" value='&lt;font color="#555555" style="font-size:9px"&gt;«device»&lt;/font&gt;&lt;br&gt;&lt;b&gt;Monitoramento externo&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9.5px"&gt;ex.: UptimeRobot · avisa a equipe&lt;br&gt;se o sistema cair (RNF07)&lt;/font&gt;' style="shape=cube;size=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;spacingRight=8;container=1;collapsible=0;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="260" height="130" as="geometry"/></mxCell><mxCell id="i0-vercel" value='&lt;font color="#555555" style="font-size:9px"&gt;«device» «cloud»&lt;/font&gt;&lt;br&gt;&lt;b&gt;Vercel (plano Hobby)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9.5px"&gt;HTTPS automático · *.vercel.app&lt;/font&gt;' style="shape=cube;size=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;spacingRight=8;container=1;collapsible=0;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="460" y="90" width="320" height="300" as="geometry"/></mxCell><mxCell id="i0-vnode" value='&lt;font color="#555555" style="font-size:9px"&gt;«executionEnvironment»&lt;/font&gt;&lt;br&gt;&lt;b&gt;Node.js 24 (funções do Next.js 16)&lt;/b&gt;' style="shape=cube;size=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;spacingRight=8;container=1;collapsible=0;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="i0-vercel"><mxGeometry x="20" y="75" width="280" height="205" as="geometry"/></mxCell><mxCell id="i0-site" value='&lt;font color="#666666" style="font-size:9px"&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;site SIGA (build da branch main)&lt;/b&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="i0-vnode"><mxGeometry x="15" y="57" width="250" height="45" as="geometry"/></mxCell><mxCell id="i0-vprx" value='&lt;font color="#666666" style="font-size:9px"&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;proxy.ts (sessão) + rewrites /api/v1&lt;/b&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="i0-vnode"><mxGeometry x="15" y="107" width="250" height="45" as="geometry"/></mxCell><mxCell id="i0-vcfg" value='&lt;font color="#666666" style="font-size:9px"&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;API_URL = endereço da API no Render&lt;/b&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="i0-vnode"><mxGeometry x="15" y="157" width="250" height="45" as="geometry"/></mxCell><mxCell id="i0-render" value='&lt;font color="#555555" style="font-size:9px"&gt;«device» «cloud»&lt;/font&gt;&lt;br&gt;&lt;b&gt;Render (Free Web Service)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9.5px"&gt;dorme após ~15 min sem uso; o 1º acesso leva 30 a 60 s&lt;/font&gt;' style="shape=cube;size=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;spacingRight=8;container=1;collapsible=0;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="900" y="90" width="380" height="640" as="geometry"/></mxCell><mxCell id="i0-rnode" value='&lt;font color="#555555" style="font-size:9px"&gt;«executionEnvironment» «container»&lt;/font&gt;&lt;br&gt;&lt;b&gt;Python 3.12 + Uvicorn&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9.5px"&gt;FastAPI · render.yaml&lt;/font&gt;' style="shape=cube;size=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;spacingRight=8;container=1;collapsible=0;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="i0-render"><mxGeometry x="20" y="85" width="340" height="330" as="geometry"/></mxCell><mxCell id="i0-rapi" value='&lt;font color="#666666" style="font-size:9px"&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;API SIGA (backend/)&lt;/b&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="i0-rnode"><mxGeometry x="15" y="70" width="310" height="45" as="geometry"/></mxCell><mxCell id="i0-rstart" value='&lt;font color="#666666" style="font-size:9px"&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;ao subir: migrações + carga inicial&lt;br&gt;(python -m app.seed)&lt;/b&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="i0-rnode"><mxGeometry x="15" y="122" width="310" height="50" as="geometry"/></mxCell><mxCell id="i0-rcfg" value='&lt;font color="#666666" style="font-size:9px"&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;DATABASE_URL, BREVO_API_KEY, FRONTEND_URL,&lt;br&gt;COOKIE_SEGURO=1&lt;/b&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="i0-rnode"><mxGeometry x="15" y="179" width="310" height="55" as="geometry"/></mxCell><mxCell id="i0-rpdf" value='&lt;font color="#666666" style="font-size:9px"&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;gerador de PDF: ata, folha, certificados,&lt;br&gt;relatório (RBN09.14 a 09.17, RBN13.06)&lt;/b&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;dashPattern=6 4;" vertex="1" parent="i0-rnode"><mxGeometry x="15" y="241" width="310" height="55" as="geometry"/></mxCell><mxCell id="i0-cron" value='&lt;font color="#555555" style="font-size:9px"&gt;«executionEnvironment» «container»&lt;/font&gt;&lt;br&gt;&lt;b&gt;Cron Job · Python 3.12&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9.5px"&gt;mesmo código, banco e e-mail da API&lt;/font&gt;' style="shape=cube;size=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;spacingRight=8;container=1;collapsible=0;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;dashPattern=6 4;" vertex="1" parent="i0-render"><mxGeometry x="20" y="450" width="340" height="170" as="geometry"/></mxCell><mxCell id="i0-tarefas" value='&lt;font color="#666666" style="font-size:9px"&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;tarefas agendadas: lembrete da defesa&lt;br&gt;(RBN09.06), revogar aluno (RBN01.11),&lt;br&gt;expirar conta externa (RBN01.12), reenviar&lt;br&gt;e-mails, cópia diária do banco&lt;/b&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;dashPattern=6 4;" vertex="1" parent="i0-cron"><mxGeometry x="15" y="65" width="310" height="95" as="geometry"/></mxCell><mxCell id="i0-neon" value='&lt;font color="#555555" style="font-size:9px"&gt;«device» «cloud»&lt;/font&gt;&lt;br&gt;&lt;b&gt;Neon (plano grátis)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9.5px"&gt;PostgreSQL gerenciado&lt;/font&gt;' style="shape=cube;size=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;spacingRight=8;container=1;collapsible=0;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1420" y="90" width="330" height="240" as="geometry"/></mxCell><mxCell id="i0-pg" value='&lt;font color="#555555" style="font-size:9px"&gt;«executionEnvironment»&lt;/font&gt;&lt;br&gt;&lt;b&gt;PostgreSQL 16&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9.5px"&gt;conexão com TLS (sslmode=require)&lt;/font&gt;' style="shape=cube;size=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;spacingRight=8;container=1;collapsible=0;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="i0-neon"><mxGeometry x="20" y="75" width="290" height="145" as="geometry"/></mxCell><mxCell id="i0-pbanco" value='&lt;font color="#666666" style="font-size:9px"&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;banco siga (23 tabelas hoje, 46 no fim)&lt;/b&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="i0-pg"><mxGeometry x="15" y="70" width="260" height="55" as="geometry"/></mxCell><mxCell id="i0-stor" value='&lt;font color="#555555" style="font-size:9px"&gt;«device»&lt;/font&gt;&lt;br&gt;&lt;b&gt;Armazenamento de arquivos e backup&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9.5px"&gt;ex.: Supabase Storage · PDFs do TCC até 20 MB&lt;br&gt;(RAN07) e cópias do banco por 5 anos (RNF03)&lt;/font&gt;' style="shape=cube;size=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;spacingRight=8;container=1;collapsible=0;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1420" y="400" width="330" height="150" as="geometry"/></mxCell><mxCell id="i0-smtp" value='&lt;font color="#555555" style="font-size:9px"&gt;«device»&lt;/font&gt;&lt;br&gt;&lt;b&gt;Brevo (envio de e-mail)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9.5px"&gt;API HTTPS · remetente siga.uea1@gmail.com&lt;br&gt;o Render grátis bloqueia SMTP (25, 465 e 587)&lt;/font&gt;' style="shape=cube;size=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;spacingRight=8;container=1;collapsible=0;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1420" y="620" width="330" height="140" as="geometry"/></mxCell><mxCell id="i0-nota" value="&lt;b&gt;Notas&lt;/b&gt;&lt;br&gt;• O navegador só fala com a Vercel; a Vercel repassa /api/v1 ao Render. O cookie de sessão fica na mesma origem (httponly e Secure), sem CORS.&lt;br&gt;• RNF02: HTTPS em todo o caminho (TLS ≥ 1.2) e TLS também até o banco.&lt;br&gt;• RNF03: o log de auditoria fica no PostgreSQL, que recusa alterar ou apagar registros.&lt;br&gt;• RNF07: o plano grátis do Render dorme; para 99% no pico é preciso um plano pago ou o monitoramento acordando a API.&lt;br&gt;• E-mail pela API HTTPS da Brevo, porque o Render grátis bloqueia SMTP; no ambiente local continua o SMTP do Gmail.&lt;br&gt;• Deploy automático a cada push na main (HT06, CA-02).&lt;br&gt;• Configuração no repositório: render.yaml, .vercelignore e README (Publicar na internet).&lt;br&gt;• Situação em 21/10/2026: API publicada no Render; site na Vercel, banco no Neon e e-mail na Brevo em configuração." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=10.5;fillColor=#fffde7;strokeColor=#b7a63a;" vertex="1" parent="1"><mxGeometry x="1830" y="90" width="330" height="380" as="geometry"/></mxCell><mxCell id="i0-e0" value="" style="edgeStyle=none;rounded=1;html=1;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.4667;entryDx=0;entryDy=0;entryPerimeter=0;endArrow=none;strokeColor=#333333;strokeWidth=1.4;" edge="1" parent="1" source="i0-cli" target="i0-vercel"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="i0-e0-l" value="HTTPS · :443" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#222222;labelBackgroundColor=none;" vertex="1" connectable="0" parent="i0-e0"><mxGeometry x="0.0000" relative="1" as="geometry"><mxPoint x="0" y="-13" as="offset"/></mxGeometry></mxCell><mxCell id="i0-e1" value="" style="edgeStyle=none;rounded=1;html=1;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.2344;entryDx=0;entryDy=0;entryPerimeter=0;endArrow=none;strokeColor=#333333;strokeWidth=1.4;" edge="1" parent="1" source="i0-vercel" target="i0-render"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="i0-e1-l" value="HTTPS&lt;br&gt;/api/v1/*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#222222;labelBackgroundColor=none;" vertex="1" connectable="0" parent="i0-e1"><mxGeometry x="0.0000" relative="1" as="geometry"><mxPoint x="0" y="-20" as="offset"/></mxGeometry></mxCell><mxCell id="i0-e2" value="" style="edgeStyle=none;rounded=1;html=1;exitX=1.0000;exitY=0.1969;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5250;entryDx=0;entryDy=0;entryPerimeter=0;endArrow=none;strokeColor=#333333;strokeWidth=1.4;" edge="1" parent="1" source="i0-render" target="i0-neon"><m