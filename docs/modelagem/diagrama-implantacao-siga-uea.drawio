pc"><mxGeometry x="290" y="80" width="280" height="220" as="geometry"/></mxCell><mxCell id="i2-dev" value='&lt;font color="#666666" style="font-size:9px"&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;npm run dev (Next.js, porta 3000)&lt;/b&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="i2-node"><mxGeometry x="15" y="55" width="250" height="50" as="geometry"/></mxCell><mxCell id="i2-prx" value='&lt;font color="#666666" style="font-size:9px"&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;proxy.ts + rewrites de /api/v1&lt;/b&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="i2-node"><mxGeometry x="15" y="115" width="250" height="50" as="geometry"/></mxCell><mxCell id="i2-py" value='&lt;font color="#555555" style="font-size:9px"&gt;«executionEnvironment»&lt;/font&gt;&lt;br&gt;&lt;b&gt;Python 3.12 (backend/.venv)&lt;/b&gt;' style="shape=cube;size=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;spacingRight=8;container=1;collapsible=0;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="i2-pc"><mxGeometry x="620" y="80" width="320" height="330" as="geometry"/></mxCell><mxCell id="i2-uv" value='&lt;font color="#666666" style="font-size:9px"&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;uvicorn app.main:app --reload (8000)&lt;/b&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="i2-py"><mxGeometry x="15" y="55" width="290" height="50" as="geometry"/></mxCell><mxCell id="i2-tst" value='&lt;font color="#666666" style="font-size:9px"&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;pytest (testes da API)&lt;/b&gt;' style="shap