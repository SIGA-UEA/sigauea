ingLeft=18;spacingTop=14;spacingRight=8;container=1;collapsible=0;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="i1-dock"><mxGeometry x="40" y="75" width="240" height="200" as="geometry"/></mxCell><mxCell id="i1-webimg" value='&lt;font color="#666666" style="font-size:9px"&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;imagem web (Dockerfile)&lt;/b&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="i1-web"><mxGeometry x="15" y="75" width="210" height="50" as="geometry"/></mxCell><mxCell id="i1-webcfg" value='&lt;font color="#666666" style="font-size:9px"&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;API_URL=http://api:8000&lt;/b&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="i1-web"><mxGeometry x="15" y="133" width="210" height="45" as="geometry"/></mxCell><mxCell id="i1-env" value='&lt;font color="#666666" style="font-size:9px"&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;variáveis do Compose&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9.5px"&gt;POSTGRES_PASSWORD, FRONTEND_URL,&lt;br&gt;COOKIE_SEGURO, SMTP_* (opcionais)&lt;/font&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="i1-dock"><mxGeometry x="40" y="320" width="240" height="110" as="geometry"/></mxCell><mxCell id="i1-api" value='&lt;font color="#555555" style="font-size:9px"&gt;«executionEnvironment» «container»&lt;/font&gt;&lt;br&gt;&lt;b&gt;api · Python 3.12 + Uvicorn&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9.5px"&gt;FastAPI · porta 8000 publicada&lt;/font&gt;' style="shape=cube;size=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;spacingRight=8;container=1;collapsible=0;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="i1-dock"><mxGeometry x="380" y="75" width="280" height="300" as="geometry"/></mxCell><mxCell id="i1-apiimg" value='&lt;font color="#666666" style="font-size:9px"&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;imagem api (backend/Dockerfile)&lt;/b&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="i1-api"><mxGeometry x="15" y="75" width="250" height="50" as="geometry"/></mxCell><mxCell id="i1-mig" value='&lt;font color="#666666" style="font-size:9px"&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;ao subir: alembic upgrade head&lt;/b&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="i1-api"><mxGeometry x="15" y="133" width="250" height="50" as="geometry"/></mxCell><mxCell id="i1-seed" value='&lt;font color="#666666" style="font-size:9px"&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;docker compose run api&lt;br&gt;python -m app.seed&lt;/b&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="i1-api"><mxGeometry x="15" y="191" width="250" height="50" as="geometry"/></mxCell><mxCell id="i1-db" value='&lt;font color="#555555" style="font-size:9px"&gt;«executionEnvironment» «container»&lt;/font&gt;&lt;br&gt;&lt;b&gt;db · PostgreSQL 16&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9.5px"&gt;imagem postgres:16-alpine&lt;br&gt;porta 5432 só na rede do Compose&lt;/font&gt;' style="shape=cube;size=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;spacingRight=8;container=1;collapsible=0;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="i1-dock"><mxGeometry x="760" y="75" width="260" height="260" as="geometry"/></mxCell><mxCell id="i1-banco" value='&lt;font color="#666666" style="font-size:9px"&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;banco siga&lt;/b&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="i1-db"><mxGeometry x="15" y="90" width="230" height="55" as="geometry"/></mxCell><mxCell id="i1-vol" value='&lt;font color="#666666" style="font-size:9px"&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;volume &lt;i&gt;dados&lt;/i&gt;&lt;br&gt;(/var/lib/postgresql/data)&lt;/b&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="i1-db"><mxGeometry x="15" y="155" width="230" height="60" as="geometry"/></mxCell><mxCell id="i1-nota" value="&lt;b&gt;Notas&lt;/b&gt;&lt;br&gt;• Subir tudo: docker compose up --build -d (README, seção Com Docker).&lt;br&gt;• Sem Docker também funciona: npm run dev, uvicorn --reload e SQLite (README, Como rodar).&lt;br&gt;• A execução registrada em docs/testes rodou fora do Docker: API e site locais (build de produção) com PostgreSQL 16 e SQLite.&lt;br&gt;• Sem SMTP configurado, os e-mails aparecem no log da API (docker compose logs -f api)." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=10.5;fillColor=#fffde7;strokeColor=#b7a63a;" vertex="1" parent="1"><mxGeometry x="1440" y="70" width="330" height="320" as="geometry"/></mxCell><mxCell id="i1-smtp" value='&lt;font color="#555555" style="font-size:9px"&gt;«device»&lt;/font&gt;&lt;br&gt;&lt;b&gt;Servidor de e-mail&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9.5px"&gt;smtp.gmail.com :587 · opcional&lt;/font&gt;' style="shape=cube;size=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=1