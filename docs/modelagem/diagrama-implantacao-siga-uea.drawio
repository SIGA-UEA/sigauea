<mxfile host="app.diagrams.net"><diagram name="1 · Produção (servidor com Docker)" id="impl-0"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1980" pageHeight="830" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="i0-t" value="SIGA UEA · Diagrama de implantação · Produção: um servidor com Docker Compose (HT06)" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="1500" height="34" as="geometry"/></mxCell><mxCell id="i0-cli" value='&lt;font color="#555555" style="font-size:9px"&gt;«device»&lt;/font&gt;&lt;br&gt;&lt;b&gt;Computador ou celular do usuário&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9.5px"&gt;aluno, docente, coordenação, banca&lt;/font&gt;' style="shape=cube;size=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;spacingRight=8;container=1;collapsible=0;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="280" height="220" as="geometry"/></mxCell><mxCell id="i0-nav" value='&lt;font color="#555555" style="font-size:9px"&gt;«executionEnvironment»&lt;/font&gt;&lt;br&gt;&lt;b&gt;Navegador web&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9.5px"&gt;Chrome ou Safari, a partir de 360 px (RNF04)&lt;/font&gt;' style="shape=cube;size=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;spacingRight=8;container=1;collapsible=0;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="i0-cli"><mxGeometry x="20" y="65" width="240" height="135" as="geometry"/></mxCell><mxCell id="i0-ui" value='&lt;font color="#666666" style="font-size:9px"&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;Interface SIGA&lt;/b&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="i0-nav"><mxGeometry x="15" y="65" width="210" height="55" as="geometry"/></mxCell><mxCell id="i0-git" value='&lt;font color="#555555" style="font-size:9px"&gt;«device»&lt;/font&gt;&lt;br&gt;&lt;b&gt;GitHub&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9.5px"&gt;repositório SIGA-UEA/sigauea&lt;/font&gt;' style="shape=cube;size=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;spacingRight=8;container=1;collapsible=0;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="280" height="150" as="geometry"/></mxCell><mxCell id="i0-repo" value='&lt;font color="#666666" style="font-size:9px"&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;código da branch main&lt;/b&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="i0-git"><mxGeometry x="20" y="70" width="240" height="60" as="geometry"/></mxCell><mxCell id="i0-srv" value='&lt;font color="#555555" style="font-size:9px"&gt;«device»&lt;/font&gt;&lt;br&gt;&lt;b&gt;Servidor de aplicação · VM Linux&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9.5px"&gt;2 vCPU · 4 GB de RAM · 20 GB de disco · provedor a definir (HT06)&lt;/font&gt;' style="shape=cube;size=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;spacingRight=8;container=1;collapsible=0;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="380" y="70" width="1120" height="700" as="geometry"/></mxCell><mxCell id="i0-dock" value='&lt;font color="#555555" style="font-size:9px"&gt;«executionEnvironment»&lt;/font&gt;&lt;br&gt;&lt;b&gt;Docker Engine + Docker Compose&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9.5px"&gt;docker-compose.yml&lt;/font&gt;' style="shape=cube;size=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;spacingRight=8;container=1;collapsible=0;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="i0-srv"><mxGeometry x="20" y="80" width="1080" height="600" as="geometry"/></mxCell><mxCell id="i0-proxy" value='&lt;font color="#555555" style="font-size:9px"&gt;«executionEnvironment» «container»&lt;/font&gt;&lt;br&gt;&lt;b&gt;proxy · Caddy ou Nginx&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9.5px"&gt;porta 443, a única exposta&lt;/font&gt;' style="shape=cube;size=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;spacingRight=8;container=1;collapsible=0;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;dashPattern=6 4;" vertex="1" parent="i0-dock"><mxGeometry x="20" y="75" width="210" height="190" as="geometry"/></mxCell><mxCell id="i0-cert" value="&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;certificado TLS&lt;br&gt;(Let's Encrypt)&lt;/b&gt;" style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="i0-proxy"><mxGeometry x="15" y="95" width="180" height="70" as="geometry"/></mxCell><mxCell id="i0-web" value='&lt;font color="#555555" style="font-size:9px"&gt;«executionEnvironment» «container»&lt;/font&gt;&lt;br&gt;&lt;b&gt;web · Node.js 24&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9.5px"&gt;Next.js 16 · porta 3000&lt;/font&gt;' style="shape=cube;size=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;spacingRight=8;container=1;collapsible=0;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="i0-dock"><mxGeometry x="270" y="75" width="230" height="190" as="geometry"/></mxCell><mxCell id="i0-webimg" value='&lt;font color="#666666" style="font-size:9px"&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;imagem web (Dockerfile)&lt;/b&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="i0-web"><mxGeometry x="15" y="75" width="200" height="55" as="geometry"/></mxCell><mxCell id="i0-webcfg" value='&lt;font color="#666666" style="font-size:9px"&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;API_URL=http://api:8000&lt;/b&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="i0-web"><mxGeometry x="15" y="137" width="200" height="40" as="geometry"/></mxCell><mxCell id="i0-api" value='&lt;font color="#555555" style="font-size:9px"&gt;«executionEnvironment» «container»&lt;/font&gt;&lt;br&gt;&lt;b&gt;api · Python 3.12 + Uvicorn&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9.5px"&gt;FastAPI · porta 8000&lt;/font&gt;' style="shape=cube;size=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;spacingRight=8;container=1;collapsible=0;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="i0-dock"><mxGeometry x="540" y="75" width="260" height="290" as="geometry"/></mxCell><mxCell id="i0-apiimg" value='&lt;font color="#666666" style="font-size:9px"&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;imagem api (backend/Dockerfile)&lt;/b&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="i0-api"><mxGeometry x="15" y="75" width="230" height="50" as="geometry"/></mxCell><mxCell id="i0-mig" value='&lt;font color="#666666" style="font-size:9px"&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;migrações Alembic 0001 a 0004&lt;/b&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="i0-api"><mxGeometry x="15" y="133" width="230" height="50" as="geometry"/></mxCell><mxCell id="i0-seed" value='&lt;font color="#666666" style="font-size:9px"&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;carga inicial (python -m app.seed)&lt;/b&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="i0-api"><mxGeometry x="15" y="191" width="230" height="50" as="geometry"/></mxCell><mxCell id="i0-db" value='&lt;font color="#555555" style="font-size:9px"&gt;«executionEnvironment» «container»&lt;/font&gt;&lt;br&gt;&lt;b&gt;db · PostgreSQL 16&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9.5px"&gt;porta 5432 · só na rede interna&lt;/font&gt;' style="shape=cube;size=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;spacingRight=8;container=1;collapsible=0;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="i0-dock"><mxGeometry x="840" y="75" width="220" height="290" as="geometry"/></mxCell><mxCell id="i0-banco" value='&lt;font color="#666666" style="font-size:9px"&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;banco siga&lt;br&gt;(23 tabelas hoje, 45 no fim)&lt;/b&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="i0-db"><mxGeometry x="15" y="75" width="190" height="55" as="geometry"/></mxCell><mxCell id="i0-vol" value='&lt;font color="#666666" style="font-size:9px"&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;volume &lt;i&gt;dados&lt;/i&gt;&lt;br&gt;(/var/lib/postgresql/data)&lt;/b&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="i0-db"><mxGeometry x="15" y="143" width="190" height="55" as="geometry"/></mxCell><mxCell id="i0-env" value='&lt;font color="#666666" style="font-size:9px"&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;.env do servidor&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9.5px"&gt;DATABASE_URL, POSTGRES_PASSWORD, FRONTEND_URL, COOKIE_SEGURO=1, SMTP_*&lt;/font&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="i0-dock"><mxGeometry x="270" y="320" width="230" height="110" as="geometry"/></mxCell><mxCell id="i0-smtp" value='&lt;font color="#555555" style="font-size:9px"&gt;«device»&lt;/font&gt;&lt;br&gt;&lt;b&gt;Servidor de e-mail&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9.5px"&gt;smtp.gmail.com · conta siga.uea1@gmail.com&lt;/font&gt;' style="shape=cube;size=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;spacingRight=8;container=1;collapsible=0;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1580" y="560" width="260" height="150" as="geometry"/></mxCell><mxCell id="i0-nota" value="&lt;b&gt;Notas&lt;/b&gt;&lt;br&gt;• RNF02: só o proxy é exposto, na porta 443 (TLS ≥ 1.2); site, API e banco ficam na rede interna do Compose. O cookie de sessão é httponly e, em produção, Secure (COOKIE_SEGURO=1).&lt;br&gt;• RNF03: o log de auditoria fica no PostgreSQL, que o banco não deixa alterar nem apagar; o volume &lt;i&gt;dados&lt;/i&gt; precisa de backup para a retenção de 5 anos.&lt;br&gt;• RNF07: 99% de disponibilidade no pico, com recuperação em até 30 min (reinício dos containers e restauração do backup).&lt;br&gt;• A API aplica as migrações ao subir (alembic upgrade head) e só então atende.&lt;br&gt;• Em amarelo tracejado: o que ainda não existe no repositório (proxy HTTPS)." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=10.5;fillColor=#fffde7;strokeColor=#b7a63a;" vertex="1" parent="1"><mxGeometry x="1580" y="70" width="340" height="330" as="geometry"/></mxCell><mxCell id="i0-e0" value="HTTPS · TLS ≥ 1.2 · :443" style="edgeStyle=none;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.55;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;endArrow=none;strokeColor=#333333;strokeWidth=1.4;" edge="1" parent="1" source="i0-cli" target="i0-proxy"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="370" y="231.0"/><mxPoint x="370" y="301.0"/></Array></mxGeometry></mxCell><mxCell id="i0-e1" value="HTTP · :3000" style="edgeStyle=none;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;endArrow=none;strokeColor=#333333;strokeWidth=1.4;" edge="1" parent="1" source="i0-proxy" target="i0-web"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="i0-e2" value="HTTP · :8000&lt;br&gt;/api/v1/* (rewrite)" style="edgeStyle=none;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.27;entryDx=0;entryDy=0;endArrow=none;strokeColor=#333333;strokeWidth=1.4;" edge="1" parent="1" source="i0-web" target="i0-api"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="920" y="301.0"/><mxPoint x="920" y="303.3"/></Array></mxGeometry></mxCell><mxCell id="i0-e3" value="TCP · :5432&lt;br&gt;psycopg" style="edgeStyle=none;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.27;exitDx=0;exitDy=0;entryX=0;entryY=0.27;entryDx=0;entryDy=0;endArrow=none;strokeColor=#333333;strokeWidth=1.4;" edge="1" parent="1" source="i0-api" target="i0-db"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="i0-e4" value="SMTP · STARTTLS · :587&lt;br&gt;(ativação, senha, orientação)" style="edgeStyle=none;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=none;strokeColor=#333333;strokeWidth=1.4;" edge="1" parent="1" source="i0-api" target="i0-smtp"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1070" y="635"/></Array></mxGeometry></mxCell><mxCell id="i0-e5" value="«deploy» git pull +&lt;br&gt;docker compose up --build" style="edgeStyle=none;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;dashed=1;endArrow=open;endSize=10;strokeColor=#7a7a7a;fontColor=#555555;" edge="1" parent="1" source="i0-git" target="i0-srv"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="350" y="545.0"/><mxPoint x="350" y="490.0"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="2 · Homologação (serviços gratuitos)" id="impl-1"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1630" pageHeight="860" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="i1-t" value="SIGA UEA · Diagrama de implantação · Homologação: serviços gratuitos separados" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="1500" height="34" as="geometry"/></mxCell><mxCell id="i1-cli" value='&lt;font color="#555555" style="font-size:9px"&gt;«device»&lt;/font&gt;&lt;br&gt;&lt;b&gt;Computador ou celular do usuário&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9.5px"&gt;coordenação e equipe testando&lt;/font&gt;' style="shape=cube;size=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;spacingRight=8;container=1;collapsible=0;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="280" height="220" as="geometry"/></mxCell><mxCell id="i1-nav" value='&lt;font color="#555555" style="font-size:9px"&gt;«executionEnvironment»&lt;/font&gt;&lt;br&gt;&lt;b&gt;Navegador web&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9.5px"&gt;Chrome ou Safari&lt;/font&gt;' style="shape=cube;size=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;spacingRight=8;container=1;collapsible=0;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="i1-cli"><mxGeometry x="20" y="65" width="240" height="135" as="geometry"/></mxCell><mxCell id="i1-ui" value='&lt;font color="#666666" style="font-size:9px"&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;Interface SIGA&lt;/b&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="i1-nav"><mxGeometry x="15" y="65" width="210" height="55" as="geometry"/></mxCell><mxCell id="i1-git" value='&lt;font color="#555555" style="font-size:9px"&gt;«device»&lt;/font&gt;&lt;br&gt;&lt;b&gt;GitHub&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9.5px"&gt;repositório SIGA-UEA/sigauea&lt;/font&gt;' style="shape=cube;size=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;spacingRight=8;container=1;collapsible=0;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="280" height="150" as="geometry"/></mxCell><mxCell id="i1-repo" value='&lt;font color="#666666" style="font-size:9px"&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;código da branch main&lt;/b&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="i1-git"><mxGeometry x="20" y="70" width="240" height="60" as="geometry"/></mxCell><mxCell id="i1-vercel" value='&lt;font color="#555555" style="font-size:9px"&gt;«device» «cloud»&lt;/font&gt;&lt;br&gt;&lt;b&gt;Vercel (plano Hobby)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9.5px"&gt;HTTPS automático · domínio *.vercel.app&lt;/font&gt;' style="shape=cube;size=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;spacingRight=8;container=1;collapsible=0;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="400" y="90" width="320" height="290" as="geometry"/></mxCell><mxCell id="i1-vnode" value='&lt;font color="#555555" style="font-size:9px"&gt;«executionEnvironment»&lt;/font&gt;&lt;br&gt;&lt;b&gt;Node.js 24 (funções do Next)&lt;/b&gt;' style="shape=cube;size=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;spacingRight=8;container=1;collapsible=0;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="i1-vercel"><mxGeometry x="20" y="75" width="280" height="195" as="geometry"/></mxCell><mxCell id="i1-site" value='&lt;font color="#666666" style="font-size:9px"&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;site Next.js 16 (build da main)&lt;/b&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="i1-vnode"><mxGeometry x="15" y="60" width="250" height="55" as="geometry"/></mxCell><mxCell id="i1-vcfg" value='&lt;font color="#666666" style="font-size:9px"&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;API_URL = endereço da API no Render&lt;/b&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="i1-vnode"><mxGeometry x="15" y="125" width="250" height="55" as="geometry"/></mxCell><mxCell id="i1-render" value='&lt;font color="#555555" style="font-size:9px"&gt;«device» «cloud»&lt;/font&gt;&lt;br&gt;&lt;b&gt;Render (Free Web Service)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9.5px"&gt;dorme após ~15 min sem uso; o 1º acesso leva 30 a 60 s&lt;/font&gt;' style="shape=cube;size=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;spacingRight=8;container=1;collapsible=0;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="800" y="90" width="360" height="360" as="geometry"/></mxCell><mxCell id="i1-rnode" value='&lt;font color="#555555" style="font-size:9px"&gt;«executionEnvironment» «container»&lt;/font&gt;&lt;br&gt;&lt;b&gt;Python 3.12 + Uvicorn&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9.5px"&gt;FastAPI&lt;/font&gt;' style="shape=cube;size=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;spacingRight=8;container=1;collapsible=0;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="i1-render"><mxGeometry x="20" y="85" width="320" height="255" as="geometry"/></mxCell><mxCell id="i1-rapi" value='&lt;font color="#666666" style="font-size:9px"&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;API SIGA (backend/)&lt;/b&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="i1-rnode"><mxGeometry x="15" y="70" width="290" height="50" as="geometry"/></mxCell><mxCell id="i1-rstart" value='&lt;font color="#666666" style="font-size:9px"&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;start: python -m app.seed &amp;&amp; uvicorn …&lt;/b&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="i1-rnode"><mxGeometry x="15" y="127" width="290" height="50" as="geometry"/></mxCell><mxCell id="i1-rcfg" value='&lt;font color="#666666" style="font-size:9px"&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;DATABASE_URL, SMTP_*, FRONTEND_URL,&lt;br&gt;COOKIE_SEGURO=1&lt;/b&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="i1-rnode"><mxGeometry x="15" y="184" width="290" height="55" as="geometry"/></mxCell><mxCell id="i1-neon" value='&lt;font color="#555555" style="font-size:9px"&gt;«device» «cloud»&lt;/font&gt;&lt;br&gt;&lt;b&gt;Neon ou Supabase (plano grátis)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9.5px"&gt;Supabase: usar o Session pooler (IPv4)&lt;/font&gt;' style="shape=cube;size=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;spacingRight=8;container=1;collapsible=0;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1240" y="90" width="330" height="240" as="geometry"/></mxCell><mxCell id="i1-pg" value='&lt;font color="#555555" style="font-size:9px"&gt;«executionEnvironment»&lt;/font&gt;&lt;br&gt;&lt;b&gt;PostgreSQL 16 gerenciado&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9.5px"&gt;conexão com TLS&lt;/font&gt;' style="shape=cube;size=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;spacingRight=8;container=1;collapsible=0;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="i1-neon"><mxGeometry x="20" y="75" width="290" height="145" as="geometry"/></mxCell><mxCell id="i1-pbanco" value='&lt;font color="#666666" style="font-size:9px"&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;banco siga&lt;/b&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="i1-pg"><mxGeometry x="15" y="70" width="260" height="55" as="geometry"/></mxCell><mxCell id="i1-smtp" value='&lt;font color="#555555" style="font-size:9px"&gt;«device»&lt;/font&gt;&lt;br&gt;&lt;b&gt;Servidor de e-mail&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9.5px"&gt;smtp.gmail.com :587 · se o Render bloquear SMTP, trocar por Brevo ou Resend (API HTTPS)&lt;/font&gt;' style="shape=cube;size=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;spacingRight=8;container=1;collapsible=0;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1240" y="420" width="330" height="160" as="geometry"/></mxCell><mxCell id="i1-nota" value="&lt;b&gt;Notas&lt;/b&gt;&lt;br&gt;• Ambiente para homologação e apresentação (HT06), sem custo e sem cartão.&lt;br&gt;• Não cumpre o RNF07 (99%): a API dorme. Abrir o sistema alguns minutos antes de apresentar.&lt;br&gt;• Os limites dos planos grátis mudam: conferir no site de cada serviço antes de criar as contas.&lt;br&gt;• O cookie de sessão continua na mesma origem: o navegador só fala com a Vercel, que repassa /api/v1." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=10.5;fillColor=#fffde7;strokeColor=#b7a63a;" vertex="1" parent="1"><mxGeometry x="400" y="680" width="760" height="120" as="geometry"/></mxCell><mxCell id="i1-e0" value="HTTPS · :443" style="edgeStyle=none;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.55;entryDx=0;entryDy=0;endArrow=none;strokeColor=#333333;strokeWidth=1.4;" edge="1" parent="1" source="i1-cli" target="i1-vercel"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="360" y="220.0"/><mxPoint x="360" y="249.5"/></Array></mxGeometry></mxCell><mxCell id="i1-e1" value="HTTPS&lt;br&gt;/api/v1/* (rewrite)" style="edgeStyle=none;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.45;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;endArrow=none;strokeColor=#333333;strokeWidth=1.4;" edge="1" parent="1" source="i1-vercel" target="i1-render"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="760" y="220.5"/><mxPoint x="760" y="234.0"/></Array></mxGeometry></mxCell><mxCell id="i1-e2" value="TCP + TLS · :5432" style="edgeStyle=none;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;endArrow=none;strokeColor=#333333;strokeWidth=1.4;" edge="1" parent="1" source="i1-render" target="i1-neon"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1200" y="198.0"/><mxPoint x="1200" y="186.0"/></Array></mxGeometry></mxCell><mxCell id="i1-e3" value="SMTP · STARTTLS · :587" style="edgeStyle=none;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;endArrow=none;strokeColor=#333333;strokeWidth=1.4;" edge="1" parent="1" source="i1-render" target="i1-smtp"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1200" y="396"/><mxPoint x="1200" y="484"/></Array></mxGeometry></mxCell><mxCell id="i1-e4" value="«deploy» automático a cada push" style="edgeStyle=none;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;dashed=1;endArrow=open;endSize=10;strokeColor=#7a7a7a;fontColor=#555555;" edge="1" parent="1" source="i1-git" target="i1-vercel"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="560" y="545"/></Array></mxGeometry></mxCell><mxCell id="i1-e5" value="«deploy» automático a cada push" style="edgeStyle=none;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;dashed=1;endArrow=open;endSize=10;strokeColor=#7a7a7a;fontColor=#555555;" edge="1" parent="1" source="i1-git" target="i1-render"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="908" y="605"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="3 · Desenvolvimento local" id="impl-2"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1860" pageHeight="690" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="i2-t" value="