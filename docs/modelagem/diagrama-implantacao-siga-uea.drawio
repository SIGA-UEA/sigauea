<mxfile host="app.diagrams.net"><diagram name="1 · Produção (servidor com Docker)" id="impl-0"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2380" pageHeight="1136" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="i0-t" value="SIGA UEA · Diagrama de implantação · Produção: um servidor com Docker Compose (HT06)" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="1500" height="34" as="geometry"/></mxCell><mxCell id="i0-cli" value='&lt;font color="#555555" style="font-size:9px"&gt;«device»&lt;/font&gt;&lt;br&gt;&lt;b&gt;Computador ou celular do usuário&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9.5px"&gt;aluno, docente, coordenação e banca&lt;br&gt;(inclusive externos) · visitante da&lt;br&gt;agenda pública (RAN14)&lt;/font&gt;' style="shape=cube;size=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;spacingRight=8;container=1;collapsible=0;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="260" height="240" as="geometry"/></mxCell><mxCell id="i0-nav" value='&lt;font color="#555555" style="font-size:9px"&gt;«executionEnvironment»&lt;/font&gt;&lt;br&gt;&lt;b&gt;Navegador web&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9.5px"&gt;Chrome ou Safari, a partir de 360 px&lt;/font&gt;' style="shape=cube;size=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;spacingRight=8;container=1;collapsible=0;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="i0-cli"><mxGeometry x="20" y="95" width="220" height="130" as="geometry"/></mxCell><mxCell id="i0-ui" value='&lt;font color="#666666" style="font-size:9px"&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;Interface SIGA&lt;/b&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="i0-nav"><mxGeometry x="15" y="60" width="190" height="55" as="geometry"/></mxCell><mxCell id="i0-git" value='&lt;font color="#555555" style="font-size:9px"&gt;«device»&lt;/font&gt;&lt;br&gt;&lt;b&gt;GitHub&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9.5px"&gt;repositório SIGA-UEA/sigauea&lt;/font&gt;' style="shape=cube;size=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;spacingRight=8;container=1;collapsible=0;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="260" height="150" as="geometry"/></mxCell><mxCell id="i0-repo" value='&lt;font color="#666666" style="font-size:9px"&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;código da branch main&lt;/b&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="i0-git"><mxGeometry x="20" y="70" width="220" height="60" as="geometry"/></mxCell><mxCell id="i0-mon" value='&lt;font color="#555555" style="font-size:9px"&gt;«device»&lt;/font&gt;&lt;br&gt;&lt;b&gt;Monitoramento externo&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9.5px"&gt;ex.: UptimeRobot · avisa a equipe&lt;br&gt;se o sistema cair (RNF07)&lt;/font&gt;' style="shape=cube;size=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;spacingRight=8;container=1;collapsible=0;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="260" height="130" as="geometry"/></mxCell><mxCell id="i0-srv" value='&lt;font color="#555555" style="font-size:9px"&gt;«device»&lt;/font&gt;&lt;br&gt;&lt;b&gt;Servidor de aplicação · VM Linux&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9.5px"&gt;2 vCPU · 4 GB de RAM · 20 GB de disco · provedor a definir (HT06)&lt;/font&gt;' style="shape=cube;size=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;spacingRight=8;container=1;collapsible=0;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="460" y="70" width="1300" height="890" as="geometry"/></mxCell><mxCell id="i0-dock" value='&lt;font color="#555555" style="font-size:9px"&gt;«executionEnvironment»&lt;/font&gt;&lt;br&gt;&lt;b&gt;Docker Engine + Docker Compose&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9.5px"&gt;docker-compose.yml&lt;/font&gt;' style="shape=cube;size=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;spacingRight=8;container=1;collapsible=0;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="i0-srv"><mxGeometry x="20" y="80" width="1260" height="790" as="geometry"/></mxCell><mxCell id="i0-proxy" value='&lt;font color="#555555" style="font-size:9px"&gt;«executionEnvironment» «container»&lt;/font&gt;&lt;br&gt;&lt;b&gt;proxy · Caddy ou Nginx&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9.5px"&gt;porta 443, a única exposta&lt;/font&gt;' style="shape=cube;size=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;spacingRight=8;container=1;collapsible=0;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;dashPattern=6 4;" vertex="1" parent="i0-dock"><mxGeometry x="40" y="75" width="200" height="190" as="geometry"/></mxCell><mxCell id="i0-cert" value="&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;certificado TLS&lt;br&gt;(Let's Encrypt)&lt;/b&gt;" style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;dashPattern=6 4;" vertex="1" parent="i0-proxy"><mxGeometry x="15" y="95" width="170" height="70" as="geometry"/></mxCell><mxCell id="i0-web" value='&lt;font color="#555555" style="font-size:9px"&gt;«executionEnvironment» «container»&lt;/font&gt;&lt;br&gt;&lt;b&gt;web · Node.js 24&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9.5px"&gt;Next.js 16 · porta 3000&lt;/font&gt;' style="shape=cube;size=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;spacingRight=8;container=1;collapsible=0;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="i0-dock"><mxGeometry x="340" y="75" width="220" height="190" as="geometry"/></mxCell><mxCell id="i0-webimg" value='&lt;font color="#666666" style="font-size:9px"&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;imagem web (Dockerfile)&lt;/b&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="i0-web"><mxGeometry x="15" y="75" width="190" height="55" as="geometry"/></mxCell><mxCell id="i0-webcfg" value='&lt;font color="#666666" style="font-size:9px"&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;API_URL=http://api:8000&lt;/b&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="i0-web"><mxGeometry x="15" y="137" width="190" height="40" as="geometry"/></mxCell><mxCell id="i0-env" value='&lt;font color="#666666" style="font-size:9px"&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;.env do servidor&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9.5px"&gt;DATABASE_URL, POSTGRES_PASSWORD, FRONTEND_URL, COOKIE_SEGURO=1, SMTP_*&lt;/font&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="i0-dock"><mxGeometry x="340" y="330" width="220" height="120" as="geometry"/></mxCell><mxCell id="i0-api" value='&lt;font color="#555555" style="font-size:9px"&gt;«executionEnvironment» «container»&lt;/font&gt;&lt;br&gt;&lt;b&gt;api · Python 3.12 + Uvicorn&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9.5px"&gt;FastAPI · porta 8000&lt;/font&gt;' style="shape=cube;size=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;spacingRight=8;container=1;collapsible=0;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="i0-dock"><mxGeometry x="660" y="75" width="260" height="380" as="geometry"/></mxCell><mxCell id="i0-apiimg" value='&lt;font color="#666666" style="font-size:9px"&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;imagem api (backend/Dockerfile)&lt;/b&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="i0-api"><mxGeometry x="15" y="75" width="230" height="50" as="geometry"/></mxCell><mxCell id="i0-mig" value='&lt;font color="#666666" style="font-size:9px"&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;migrações Alembic&lt;/b&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="i0-api"><mxGeometry x="15" y="133" width="230" height="50" as="geometry"/></mxCell><mxCell id="i0-seed" value='&lt;font color="#666666" style="font-size:9px"&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;carga inicial (python -m app.seed)&lt;/b&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="i0-api"><mxGeometry x="15" y="191" width="230" height="50" as="geometry"/></mxCell><mxCell id="i0-pdf" value='&lt;font color="#666666" style="font-size:9px"&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;gerador de PDF: ata, folha, certi-&lt;br&gt;ficados, relatório (RBN09.14 a 09.17)&lt;/b&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;dashPattern=6 4;" vertex="1" parent="i0-api"><mxGeometry x="15" y="249" width="230" height="55" as="geometry"/></mxCell><mxCell id="i0-arq" value='&lt;font color="#666666" style="font-size:9px"&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;volume &lt;i&gt;arquivos&lt;/i&gt; montado na api:&lt;br&gt;PDFs até 20 MB, SHA-256 (RAN07)&lt;/b&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;dashPattern=6 4;" vertex="1" parent="i0-api"><mxGeometry x="15" y="312" width="230" height="55" as="geometry"/></mxCell><mxCell id="i0-db" value='&lt;font color="#555555" style="font-size:9px"&gt;«executionEnvironment» «container»&lt;/font&gt;&lt;br&gt;&lt;b&gt;db · PostgreSQL 16&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9.5px"&gt;porta 5432 · rede interna&lt;/font&gt;' style="shape=cube;size=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;spacingRight=8;container=1;collapsible=0;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="i0-dock"><mxGeometry x="1020" y="75" width="200" height="240" as="geometry"/></mxCell><mxCell id="i0-banco" value='&lt;font color="#666666" style="font-size:9px"&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;banco siga (23 tabelas&lt;br&gt;hoje, 45 no fim)&lt;/b&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="i0-db"><mxGeometry x="15" y="75" width="170" height="55" as="geometry"/></mxCell><mxCell id="i0-vol" value='&lt;font color="#666666" style="font-size:9px"&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;volume &lt;i&gt;dados&lt;/i&gt;&lt;br&gt;(/var/lib/postgresql/&lt;br&gt;data)&lt;/b&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="i0-db"><mxGeometry x="15" y="143" width="170" height="70" as="geometry"/></mxCell><mxCell id="i0-worker" value='&lt;font color="#555555" style="font-size:9px"&gt;«executionEnvironment» «container»&lt;/font&gt;&lt;br&gt;&lt;b&gt;worker · Python 3.12&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9.5px"&gt;mesma imagem da api · agendador&lt;/font&gt;' style="shape=cube;size=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;spacingRight=8;container=1;collapsible=0;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;dashPattern=6 4;" vertex="1" parent="i0-dock"><mxGeometry x="660" y="550" width="260" height="210" as="geometry"/></mxCell><mxCell id="i0-tarefas" value='&lt;font color="#666666" style="font-size:9px"&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;tarefas agendadas:&lt;br&gt;lembrete 1 dia antes (RBN09.06)&lt;br&gt;revogar aluno após 7 dias (RBN01.11)&lt;br&gt;expirar conta externa (RBN01.12)&lt;br&gt;reenviar e-mails com falha&lt;/b&gt;' style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;dashPattern=6 4;" vertex="1" parent="i0-worker"><mxGeometry x="15" y="75" width="230" height="115" as="geometry"/></mxCell><mxCell id="i0-smtp" value='&lt;font color="#555555" style="font-size:9px"&gt;«device»&lt;/font&gt;&lt;br&gt;&lt;b&gt;Servidor de e-mail&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9.5px"&gt;smtp.gmail.com&lt;br&gt;conta siga.uea1@gmail.com&lt;/font&gt;' style="shape=cube;size=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;spacingRight=8;container=1;collapsible=0;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1980" y="110" width="280" height="140" as="geometry"/></mxCell><mxCell id="i0-nota" value="&lt;b&gt;Notas&lt;/b&gt;&lt;br&gt;• RNF02: só o proxy é exposto (443, TLS ≥ 1.2); site, API e banco ficam na rede interna do Compose. Cookie de sessão httponly e, em produção, Secure (COOKIE_SEGURO=1).&lt;br&gt;• RNF03: o log de auditoria fica no PostgreSQL e o banco não deixa alterar nem apagar; o backup guarda banco e arquivos por 5 anos após a conclusão do TCC.&lt;br&gt;• RNF07: 99% no pico; recuperação em até 30 min (reiniciar os contêineres ou restaurar o backup).&lt;br&gt;• A API aplica as migrações ao subir (alembic upgrade head) e só então atende." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=10.5;fillColor=#fffde7;strokeColor=#b7a63a;" vertex="1" parent="1"><mxGeometry x="1980" y="300" width="340" height="330" as="geometry"/></mxCell><mxCell id="i0-bkp" value='&lt;font color="#555555" style="font-size:9px"&gt;«device»&lt;/font&gt;&lt;br&gt;&lt;b&gt;Armazenamento de backup&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9.5px"&gt;fora do servidor (outro provedor&lt;br&gt;ou disco) · retenção de 5 anos&lt;/font&gt;' style="shape=cube;size=12;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=18;spacingTop=14;spacingRight=8;container=1;collapsible=0;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1980" y="700" width="280" height="140" as="geometry"/></mxCell><mxCell id="i0-e0" value="" style="edgeStyle=none;rounded=1;html=1;exitX=1.0000;exitY=0.5833;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.1316;entryDx=0;entryDy=0;entryPerimeter=0;endArrow=none;strokeColor=#333333;strokeWidth=1.4;" edge="1" parent="1" source="i0-cli" target="i0-proxy"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="i0-e0-l" value="HTTPS · :443&lt;br&gt;TLS ≥ 1.2" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#222222;labelBackgroundColor=no