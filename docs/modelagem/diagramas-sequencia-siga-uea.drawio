;dashed=1;endArrow=open;startArrow=none;endFill=0;strokeColor=#888888;exitX=0.7514;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.6667;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p0-Tcc" target="p0-enum-DISCIPLINAS"><mxGeometry relative="1" as="geometry"><mxPoint x="2923" y="1090" as="sourcePoint"/><mxPoint x="2719" y="1544" as="targetPoint"/><Array as="points"><mxPoint x="2923" y="1156"/><mxPoint x="3194" y="1156"/><mxPoint x="3194" y="1456"/><mxPoint x="2719" y="1456"/></Array></mxGeometry></mxCell><mxCell id="p0-usa-Tcc-MODALIDADES" value="" style="edgeStyle=none;rounded=0;html=1;dashed=1;endArrow=open;startArrow=none;endFill=0;strokeColor=#888888;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p0-Tcc" target="p0-enum-MODALIDADES"><mxGeometry relative="1" as="geometry"><mxPoint x="2835" y="1090" as="sourcePoint"/><mxPoint x="2907" y="1243" as="targetPoint"/><Array as="points"><mxPoint x="2835" y="1188"/><mxPoint x="2907" y="1188"/></Array></mxGeometry></mxCell><mxCell id="p0-usa-Tcc-SITUACOES_TCC" value="" style="edgeStyle=none;rounded=0;html=1;dashed=1;endArrow=open;startArrow=none;endFill=0;strokeColor=#888888;exitX=0.6257;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p0-Tcc" target="p0-enum-SITUACOES_TCC"><mxGeometry relative="1" as="geometry"><mxPoint x="2879" y="1090" as="sourcePoint"/><mxPoint x="3097" y="1243" as="targetPoint"/><Array as="points"><mxPoint x="2879" y="1172"/><mxPoint x="3097" y="1172"/></Array></mxGeometry></mxCell><mxCell id="p0-usa-Orientacao-STATUS_ORIENTACAO" value="" style="edgeStyle=none;rounded=0;html=1;dashed=1;endArrow=open;startArrow=none;endFill=0;strokeColor=#888888;exitX=0.1989;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5031;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p0-Orientacao" target="p0-enum-STATUS_ORIENTACAO"><mxGeometry relative="1" as="geometry"><mxPoint x="892" y="634" as="sourcePoint"/><mxPoint x="864" y="774" as="targetPoint"/><Array as="points"><mxPoint x="892" y="671"/><mxPoint x="864" y="671"/></Array></mxGeometry></mxCell><mxCell id="p0-usa-Orientacao-orientacao.papel" value="" style="edgeStyle=none;rounded=0;html=1;dashed=1;endArrow=open;startArrow=none;endFill=0;strokeColor=#888888;exitX=0.5994;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5033;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p0-Orientacao" target="p0-enum-orientacao.papel"><mxGeometry relative="1" as="geometry"><mxPoint x="1037" y="634" as="sourcePoint"/><mxPoint x="1064" y="774" as="targetPoint"/><Array as="points"><mxPoint x="1037" y="671"/><mxPoint x="1064" y="671"/></Array></mxGeometry></mxCell><mxCell id="p0-usa-PublicacaoArtigo-TIPOS_VEICULO" value="" style="edgeStyle=none;rounded=0;html=1;dashed=1;endArrow=open;startArrow=none;endFill=0;strokeColor=#888888;exitX=0.7500;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p0-PublicacaoArtigo" target="p0-enum-TIPOS_VEICULO"><mxGeometry relative="1" as="geometry"><mxPoint x="3291" y="634" as="sourcePoint"/><mxPoint x="3347" y="774" as="targetPoint"/><Array as="points"><mxPoint x="3291" y="671"/><mxPoint x="3347" y="671"/></Array></mxGeometry></mxCell><mxCell id="p0-usa-PublicacaoArtigo-SITUACOES_EDITORIAIS" value="" style="edgeStyle=none;rounded=0;html=1;dashed=1;endArrow=open;startArrow=none;endFill=0;strokeColor=#888888;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.6703;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p0-PublicacaoArtigo" target="p0-enum-SITUACOES_EDITORIAIS"><mxGeometry relative="1" as="geometry"><mxPoint x="3172" y="634" as="sourcePoint"/><mxPoint x="3172" y="774" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="p0-usa-HistoricoPublicacao-SITUACOES_EDITORIAIS" value="" style="edgeStyle=none;rounded=0;html=1;dashed=1;endArrow=open;startArrow=none;endFill=0;strokeColor=#888888;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.3352;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p0-HistoricoPublicacao" target="p0-enum-SITUACOES_EDITORIAIS"><mxGeometry relative="1" as="geometry"><mxPoint x="2911" y="195" as="sourcePoint"/><mxPoint x="3111" y="774" as="targetPoint"/><Array as="points"><mxPoint x="2911" y="687"/><mxPoint x="3111" y="687"/></Array></mxGeometry></mxCell><mxCell id="p0-leg" value='&lt;b&gt;Cores&lt;/b&gt;&lt;br&gt;&lt;font color="#6c8ebf"&gt;■&lt;/font&gt; Entidade persistida (classe SQLAlchemy)&lt;br&gt;&lt;font color="#d6b656"&gt;■&lt;/font&gt; Enumeração: valores aceitos por uma coluna&lt;br&gt;&lt;br&gt;&lt;b&gt;Onde está no código&lt;/b&gt;&lt;br&gt;Cada classe está em backend/app/models.py com o mesmo nome (Tcc = class Tcc)&lt;br&gt;Tabela = nome da classe em snake_case (UsuarioPerfil → usuario_perfil)&lt;br&gt;Enumeração = constante de mesmo nome no models.py (SITUACOES_TCC), conferida por CHECK no banco, exceto as marcadas {sem CHECK no banco}&lt;br&gt;&lt;br&gt;&lt;b&gt;Atributos&lt;/b&gt;&lt;br&gt;Tipo = tipo da coluna no banco (String(150), Numeric(3,1)...)&lt;br&gt;[0..1] aceita nulo · = valor padrão · /situacao: calculado (@property), não é coluna&lt;br&gt;{PK} chave primária · {FK tcc.id} chave estrangeira para tcc.id · {unique} valor único&lt;br&gt;{in SITUACOES_TCC}: só aceita os valores dessa enumeração&lt;br&gt;Compartimento de baixo: restrições da tabela (CHECK, UNIQUE composto, índice e trigger)&lt;br&gt;&lt;br&gt;&lt;b&gt;Notação UML&lt;/b&gt;&lt;br&gt;Linha contínua: associação; seta aberta no lado navegável&lt;br&gt;Losango cheio: composição (a parte não existe sem o todo)&lt;br&gt;Triângulo vazio: herança&lt;br&gt;Linha tracejada com seta: dependência («usa»)&lt;br&gt;Na ponta: multiplicidade (1 = um, 0..1 = zero ou um, * = vários)&lt;br&gt;No meio da linha: papel, quando não repete o nome da classe (ex.: professor)' style="text;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#fafafa;strokeColor=#999999;rounded=1;arcSize=2;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="3482" y="70" width="470" height="465" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Classes 2 · Controle e serviços" id="classes-1"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="5342" pageHeight="2592" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1-t" value="SIGA UEA · Diagrama de classes · controle e serviços (51 rotas)" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1600" height="36" as="geometry"/></mxCell><mxCell id="p1-app.routes.areas" value="&lt;i&gt;«controle»&lt;/i&gt;&lt;br&gt;&lt;b&gt;ControladorAreas&lt;/b&gt;" style="swimlane;html=1;whiteSpace=wrap;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=46;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="352" y="932" width="584" height="146" as="geometry"/></mxCell><mxCell id="p1-app.routes.areas-s0" value="+ GET /areas/gestao → listar_para_gestao() : list[AreaUsoOut] [coordenador]&#10;+ POST /areas → criar_area(dados: AreaEntrada) : AreaUsoOut 201 [coordenador]&#10;+ PUT /areas/{area_id} → renomear_area(area_id, dados: AreaEntrada) : AreaUsoOut [coordenador]&#10;+ DELETE /areas/{area_id} → excluir_area(area_id) 204 [coordenador]" style="text;strokeColor=none;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=6;