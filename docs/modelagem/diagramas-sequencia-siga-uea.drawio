mxPoint x="1575" y="345"/></Array></mxGeometry></mxCell><mxCell id="p2-lib/sessao.tsx-&gt;app.routes.auth" value="" style="edgeStyle=none;rounded=0;html=1;dashed=1;endArrow=open;startArrow=none;endFill=0;strokeColor=#888888;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.8462;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p2-lib/sessao.tsx" target="p2-app.routes.auth"><mxGeometry relative="1" as="geometry"><mxPoint x="1553" y="575" as="sourcePoint"/><mxPoint x="1663" y="356" as="targetPoint"/><Array as="points"><mxPoint x="1591" y="575"/><mxPoint x="1591" y="356"/></Array></mxGeometry></mxCell><mxCell id="p2-lib/tipos.ts-&gt;app.routes.perfil" value="" style="edgeStyle=none;rounded=0;html=1;dashed=1;endArrow=open;startArrow=none;endFill=0;strokeColor=#888888;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.6739;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p2-lib/tipos.ts" target="p2-app.routes.perfil"><mxGeometry relative="1" as="geometry"><mxPoint x="463" y="1205" as="sourcePoint"/><mxPoint x="573" y="1122" as="targetPoint"/><Array as="points"><mxPoint x="501" y="1205"/><mxPoint x="501" y="1122"/></Array></mxGeometry></mxCell><mxCell id="p2-leg" value='&lt;b&gt;Cores&lt;/b&gt;&lt;br&gt;&lt;font color="#9673a6"&gt;■&lt;/font&gt; «fronteira»: tela · «componente»: parte reaproveitada&lt;br&gt;&lt;font color="#82b366"&gt;■&lt;/font&gt; «controle»: módulo de rotas da API (página 2)&lt;br&gt;&lt;br&gt;&lt;b&gt;Onde está no código&lt;/b&gt;&lt;br&gt;Tela pelo endereço: /tccs/cadastro = app/(sistema)/tccs/cadastro/page.tsx&lt;br&gt;Componente pelo arquivo: formulario-usuario = formulario-usuario.tsx&lt;br&gt;ControladorTccs = backend/app/routes/tccs.py&lt;br&gt;&lt;br&gt;&lt;b&gt;Conteúdo&lt;/b&gt;&lt;br&gt;Cada linha é uma chamada, ex.: GET /tccs → listar() = a tela faz GET /api/v1/tccs&lt;br&gt;    e quem atende na API é a função listar()&lt;br&gt;Tracejado: a tela usa o componente ou chama o controle&lt;br&gt;lib/sessao e lib/tipos são usados por quase todas as telas: a caixa diz quantas&lt;br&gt;&lt;br&gt;&lt;b&gt;Rotas que nenhuma tela chama&lt;/b&gt;&lt;br&gt;DELETE /api/v1/usuarios/{usuario_id}/foto&lt;br&gt;GET /api/v1/alunos/{usuario_id}&lt;br&gt;GET /api/v1/docentes/{usuario_id}&lt;br&gt;GET /api/v1/orientacoes/{orientacao_id}&lt;br&gt;GET /api/v1/perfis&lt;br&gt;GET /api/v1/usuarios/me&lt;br&gt;GET /health&lt;br&gt;POST /api/v1/tccs/{tcc_id}/orientacoes' style="text;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#fafafa;strokeColor=#999999;rounded=1;arcSize=2;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1874" y="70" width="470" height="420" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Classes 4 · DTOs (schemas)" id="classes-3"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3936" pageHeight="2003" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p3-t" value="SIGA UEA · Diagrama de classes · DTOs (41 classes Pydantic)" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1600" height="36" as="geometry"/></mxCell><mxCell id="p3-LoginEntrada" value="&lt;i&gt;«DTO»&lt;/i&gt;&lt;br&gt;&lt;b&gt;LoginEntrada&lt;/b&gt;" style="swimlane;html=1;whiteSpace=wrap;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=46;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2524" y="70" width="326" height="82" as="geometry"/></mxCell><mxCell id="p3-LoginEntrada-s0" value="+ email : str = Field(min_length=1, max_length=254)&#10;+ senha : str = Senha" style="text;strokeColor=none;fillColor=#ffffff;align=left;verticalAlign=top;s