s"><mxPoint x="2177" y="1903"/><mxPoint x="2177" y="1343"/></Array></mxGeometry></mxCell><mxCell id="p1-app.services.usuarios-&gt;auditoria-l0" value="«usa»" style="edgeLabel;html=0;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=9;fontColor=#333333;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="p1-app.services.usuarios-&gt;auditoria"><mxGeometry x="-0.5823" relative="1" as="geometry"><mxPoint x="0" y="10" as="offset"/></mxGeometry></mxCell><mxCell id="p1-app.services.usuarios-&gt;tokens" value="" style="edgeStyle=none;rounded=0;html=1;dashed=1;endArrow=open;startArrow=none;endFill=0;strokeColor=#888888;exitX=1.0000;exitY=0.6683;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.2471;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p1-app.services.usuarios" target="p1-app.services.tokens"><mxGeometry relative="1" as="geometry"><mxPoint x="1940" y="2036" as="sourcePoint"/><mxPoint x="2403" y="2036" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="p1-app.services.usuarios-&gt;tokens-l0" value="«usa»" style="edgeLabel;html=0;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=9;fontColor=#333333;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="p1-app.services.usuarios-&gt;tokens"><mxGeometry x="-0.2164" relative="1" as="geometry"><mxPoint x="0" y="10" as="offset"/></mxGeometry></mxCell><mxCell id="p1-leg" value='&lt;b&gt;Cores&lt;/b&gt;&lt;br&gt;&lt;font color="#82b366"&gt;■&lt;/font&gt; «controle»: recebe a requisição HTTP&lt;br&gt;&lt;font color="#d79b00"&gt;■&lt;/font&gt; «serviço»: regra de negócio e acesso ao banco&lt;br&gt;&lt;font color="#666666"&gt;■&lt;/font&gt; «utilitário»: sessão, senha, erros e conexão&lt;br&gt;&lt;br&gt;&lt;b&gt;Onde está no código&lt;/b&gt;&lt;br&gt;ControladorTccs = backend/app/routes/tccs.py (o que vem depois de Controlador é o arquivo)&lt;br&gt;ServicoTccs = backend/app/services/tccs.py (idem depois de Servico)&lt;br&gt;Deps = backend/app/deps.py; o mesmo para Security, Erros e Database&lt;br&gt;&lt;br&gt;&lt;b&gt;Operações&lt;/b&gt;&lt;br&gt;Leitura de uma linha do controle, ex.: POST /tccs → criar_rascunho(dados: TccSalvar)&lt;br&gt;    : TccOut 201 [aluno] = método e caminho, função que atende, o que recebe,&lt;br&gt;    o que devolve, status HTTP e perfil exigido&lt;br&gt;Todos os caminhos ficam sob /api/v1, menos /health&lt;br&gt;status? = parâmetro opcional da URL · [público] não exige login · [autenticado] qualquer perfil&lt;br&gt;Serviço: + função pública · - função interna (nome começa com _, ex.: _vinculo)&lt;br&gt;Rodapé: entidades, DTOs e módulos que o arquivo importa&lt;br&gt;&lt;br&gt;&lt;b&gt;Ligações&lt;/b&gt;&lt;br&gt;Tracejado «usa»: o arquivo importa o serviço' style="text;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#fafafa;strokeColor=#999999;rounded=1;arcSize=2;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="4832" y="70" width="470" height="405" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Classes 3 · Fronteira (telas)" id="classes-2"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2384" pageHeight="1594" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p2-t" value="SIGA UEA · Diagrama de classes · fronteira (19 telas e componentes)" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1600" height="36" as="geometry"/></mxCell><mxCell id="p2-app/(publico)/ativar/page.tsx" value="&lt;i&gt;«fronteira»&lt;/i&gt;&lt;br&gt;&lt;b&gt;/ativar&lt;/b&gt;" style="swimlane;html=1;whiteSpace=wrap;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=46;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12