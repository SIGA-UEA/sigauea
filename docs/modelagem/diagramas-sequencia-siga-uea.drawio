=Helvetica;" vertex="1" parent="1"><mxGeometry x="24" y="14" width="1400" height="24" as="geometry"/></mxCell><mxCell id="s8-0-2" value="RAN15 · RN07 · TEL19" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="24" y="40" width="1400" height="18" as="geometry"/></mxCell><mxCell id="s8-0-3" value='&lt;b&gt;Caminho na tela:&lt;/b&gt; TCCs → abrir o TCC → aba Defesa › &amp;quot;Presença e ocorrências&amp;quot; (liberada depois da defesa realizada) → &amp;quot;Registrar ocorrência&amp;quot; → &amp;quot;Adicionar ouvinte&amp;quot; (nome&lt;br&gt;e matrícula) ou &amp;quot;Colar uma lista&amp;quot;&lt;br&gt;&lt;font color="#b26a00"&gt;Ainda não implementado: sequência das telas do protótipo (docs/prototipos).&lt;/font&gt;' style="rounded=1;arcSize=6;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fontFamily=Helvetica;fillColor=#f7f9fc;strokeColor=#9fb3cf;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="24" y="64" width="1745" height="56" as="geometry"/></mxCell><mxCell id="s8-0-4" value="&lt;b&gt;Orientador&lt;/b&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="100" y="150" width="30" height="44" as="geometry"/></mxCell><mxCell id="s8-0-5" value='&lt;b&gt;TEL06 Acompanhamento do TCC&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#555555"&gt;/tccs/{id}&lt;/font&gt;' style="shape=umlBoundary;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#dae8fc;strokeColor=#4a6fa5;strokeWidth=1.6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="359" y="150" width="50" height="44" as="geometry"/></mxCell><mxCell id="s8-0-6" value='&lt;b&gt;TEL19 Presença e ocorrências&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#555555"&gt;aba Defesa › Presença&lt;/font&gt