="geometry"/></mxCell><mxCell id="s5-0-10" value="&lt;b&gt;InstrumentoAvaliacao&lt;/b&gt;" style="shape=umlEntity;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#fff2cc;strokeColor=#b8962e;strokeWidth=1.6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1431" y="150" width="40" height="44" as="geometry"/></mxCell><mxCell id="s5-0-11" value="&lt;b&gt;Avaliacao&lt;/b&gt;" style="shape=umlEntity;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#fff2cc;strokeColor=#b8962e;strokeWidth=1.6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1569" y="150" width="40" height="44" as="geometry"/></mxCell><mxCell id="s5-0-12" value="&lt;b&gt;AvaliacaoCriterio&lt;/b&gt;" style="shape=umlEntity;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#fff2cc;strokeColor=#b8962e;strokeWidth=1.6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1697" y="150" width="40" height="44" as="geometry"/></mxCell><mxCell id="s5-0-13" value="ref" style="shape=umlFrame;whiteSpace=wrap;html=1;width=40;height=20;fontStyle=1;fontSize=11;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="83" y="258" width="485" height="58" as="geometry"/></mxCell><mxCell id="s5-0-14" value="menu &amp;quot;TCCs&amp;quot; (TEL04) → abrir o TCC → espaço do TCC (TEL06): capa,&lt;br&gt;próximo passo e abas" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="123" y="272" width="405" height="40" as="geometry"/></mxCell><mxCell id="s5-0-15" value="1: Clicar na aba Resultado › &amp;quot;Avaliação&amp;quot;" style="html=1;rounded=0;strokeWidth=1.2;endArrow=block;endFill=1;strokeColor=#333333;verticalAlign=bottom;spacingBottom=2;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="123" y="352" as="sourcePoint"/><mxPoint x