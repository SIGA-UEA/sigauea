><mxCell id="s9-4-3" value='&lt;b&gt;Caminho na tela:&lt;/b&gt; menu &amp;quot;Usuários e perfis&amp;quot; → TEL02 (/usuarios), aba Docentes ou Alunos → botão &amp;quot;Novo docente&amp;quot; / &amp;quot;Novo aluno&amp;quot; → janela com os dados → botão &amp;quot;Salvar e&lt;br&gt;enviar ativação&amp;quot; → a pessoa aparece na lista como &amp;quot;aguardando ativação&amp;quot;&lt;br&gt;&lt;font color="#2e7d32"&gt;Sequência conferida no sistema: mesma ordem de telas, cliques e chamadas à API.&lt;/font&gt;' style="rounded=1;arcSize=6;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fontFamily=Helvetica;fillColor=#f7f9fc;strokeColor=#9fb3cf;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="24" y="64" width="2421" height="56" as="geometry"/></mxCell><mxCell id="s9-4-4" value="&lt;b&gt;Coordenação&lt;/b&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="100" y="150" width="30" height="44" as="geometry"/></mxCell><mxCell id="s9-4-5" value='&lt;b&gt;TEL02 Usuários e perfis&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#555555"&gt;/usuarios&lt;/font&gt;' style="shape=umlBoundary;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#dae8fc;strokeColor=#4a6fa5;strokeWidth=1.6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="384" y="150" width="50" height="44" as="geometry"/></mxCell><mxCell id="s9-4-6" value='&lt;b&gt;ControladorCatalogo&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#555555"&gt;routes/catalogo.py&lt;/font&gt;' style="shape=umlControl;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#d5e8d4;strokeColor=#5b8f3e;strokeWidth=1.6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="595" y="150" width="40" height="44" as="geometry"/></mxCell><mxCell id="s9-4-7" value='&lt;b&gt;ControladorU