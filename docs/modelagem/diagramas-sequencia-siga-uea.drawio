rtex="1" connectable="0" parent="p4-ocorrencia_defesa.autor_id"><mxGeometry x="-0.5036" relative="1" as="geometry"><mxPoint x="0" y="10" as="offset"/></mxGeometry></mxCell><mxCell id="p4-ocorrencia_defesa.autor_id-l2" value="1" style="edgeLabel;html=0;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=9;fontColor=#333333;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="p4-ocorrencia_defesa.autor_id"><mxGeometry x="0.4837" relative="1" as="geometry"><mxPoint x="-10" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="p4-ouvinte_defesa.defesa_id" value="" style="edgeStyle=none;rounded=0;html=1;endFill=0;startFill=0;endArrow=open;endSize=10;startArrow=none;strokeColor=#333333;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.6691;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p4-ouvinte_defesa" target="p4-defesa"><mxGeometry relative="1" as="geometry"><mxPoint x="2820" y="1808" as="sourcePoint"/><mxPoint x="3145" y="1740" as="targetPoint"/><Array as="points"><mxPoint x="3012" y="1808"/><mxPoint x="3012" y="1740"/></Array></mxGeometry></mxCell><mxCell id="p4-ouvinte_defesa.defesa_id-l0" value="*" style="edgeLabel;html=0;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=9;fontColor=#333333;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="p4-ouvinte_defesa.defesa_id"><mxGeometry x="-0.9457" relative="1" as="geometry"><mxPoint x="0" y="8" as="offset"/></mxGeometry></mxCell><mxCell id="p4-ouvinte_defesa.defesa_id-l1" value="1" style="edgeLabel;html=0;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=9;fontColor=#333333;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="p4-ouvinte_defesa.defesa_id"><mxGeometry x="0.9457" relative="1" as="geometry"><mxPoint x="0" y="8" as="offset"/></mxGeometry></mxCell><mxCell id="p4-leg" value='&lt;b&gt;Cores&lt;/b&gt;&lt;br&gt;&lt;font color="#6c8ebf"&gt;■&lt;/font&gt; «planejada · MOD04»: tabela ou colunas ainda sem migração, e o módulo&lt;br&gt;&lt;font color="#82b366"&gt;■&lt;/font&gt; «controle»: operações ainda sem rota&lt;br&gt;&lt;font color="#999999"&gt;■&lt;/font&gt; Branco: classe que já existe (detalhe na página 1)&lt;br&gt;&lt;br&gt;&lt;b&gt;De onde vem&lt;/b&gt;&lt;br&gt;Tabelas e colunas: modelo lógico aprovado (docs/modelagem/modelo_logico.py)&lt;br&gt;Operações: diagramas de sequência FL01 a FL10&lt;br&gt;Borda tracejada: planejado; sai desta página quando for implementado&lt;br&gt;&lt;br&gt;&lt;b&gt;Notação UML&lt;/b&gt;&lt;br&gt;Linha contínua: associação; seta aberta no lado navegável&lt;br&gt;Losango cheio: composição (a parte não existe sem o todo)&lt;br&gt;Triângulo vazio: herança&lt;br&gt;Linha tracejada com seta: dependência («usa»)&lt;br&gt;Na ponta: multiplicidade (1 = um, 0..1 = zero ou um, * = vários)&lt;br&gt;No meio da linha: papel, quando não repete o nome da classe (ex.: professor)' style="text;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#fafafa;strokeColor=#999999;rounded=1;arcSize=2;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="4466" y="70" width="470" height="315" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>