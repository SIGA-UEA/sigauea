"/></mxCell><mxCell id="s3-0-4" value="&lt;b&gt;Orientador&lt;/b&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="100" y="150" width="30" height="44" as="geometry"/></mxCell><mxCell id="s3-0-5" value='&lt;b&gt;TEL06 Acompanhamento do TCC&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#555555"&gt;/tccs/{id}&lt;/font&gt;' style="shape=umlBoundary;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#dae8fc;strokeColor=#4a6fa5;strokeWidth=1.6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="277" y="150" width="50" height="44" as="geometry"/></mxCell><mxCell id="s3-0-6" value='&lt;b&gt;TEL10 Banca&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#555555"&gt;espaço do TCC, aba Banca&lt;/font&gt;' style="shape=umlBoundary;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#dae8fc;strokeColor=#4a6fa5;strokeWidth=1.6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="452" y="150" width="50" height="44" as="geometry"/></mxCell><mxCell id="s3-0-7" value='&lt;b&gt;ControladorAgendamentoDefesa&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#555555"&gt;planejado&lt;/font&gt;' style="shape=umlControl;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#d5e8d4;strokeColor=#5b8f3e;strokeWidth=1.6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="751" y="150" width="40" height="44" as="geometry"/></mxCell><mxCell id="s3-0-8" value="&lt;b&gt;Tcc&lt;/b&gt;" style="shape=umlEntity;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#fff2cc;strokeColor=#b8962e;strokeWidth=1.6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="914" y="150" width="40" height="44" as="geometry"/></mxCell><mxCell id="s3-0-9" value="&lt;b&gt;Usuario&lt;/b&gt;" style="shape=umlEntity;vertica