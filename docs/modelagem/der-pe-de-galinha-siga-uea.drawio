="2044" y="445" as="sourcePoint"/><mxPoint x="2140" y="1101" as="targetPoint"/><Array as="points"><mxPoint x="2072" y="445"/><mxPoint x="2072" y="1101"/></Array></mxGeometry></mxCell><mxCell id="p2-r34" value="" style="edgeStyle=none;rounded=1;html=1;startArrow=ERzeroToOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=10;endSize=10;strokeColor=#b3b3b3;strokeWidth=1;exitX=1.0000;exitY=0.1783;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.8067;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="p2-usuario" target="p2-historico_publicacao"><mxGeometry relative="1" as="geometry"><mxPoint x="614" y="1161" as="sourcePoint"/><mxPoint x="2140" y="1161" as="targetPoint"/><Array as="points"><mxPoint x="645" y="1161"/><mxPoint x="645" y="1662"/><mxPoint x="993" y="1662"/><mxPoint x="993" y="1161"/></Array></mxGeometry></mxCell><mxCell id="p2-leg" value="&lt;b&gt;Notação pé de galinha (crow's foot)&lt;/b&gt;&lt;br&gt;Ponta no lado &lt;b&gt;pai&lt;/b&gt;: &lt;b&gt;||&lt;/b&gt; exatamente um (FK obrigatória) · &lt;b&gt;o|&lt;/b&gt; zero ou um (FK opcional)&lt;br&gt;Ponta no lado &lt;b&gt;filho&lt;/b&gt;: &lt;b&gt;o&amp;lt;&lt;/b&gt; zero ou muitos · &lt;b&gt;o|&lt;/b&gt; zero ou um (FK única)&lt;br&gt;Linha cinza clara: quem registrou ou decidiu (FK para usuario em histórico, log e colunas *_por)&lt;br&gt;&lt;br&gt;&lt;b&gt;Cores por módulo&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6c8ebf&quot;&gt;■&lt;/font&gt; MOD01 · Usuários e acesso&lt;br&gt;&lt;font color=&quot;#9673a6&quot;&gt;■&lt;/font&gt; MOD02 · Ideias de TCC&lt;br&gt;&lt;font color=&quot;#82b366&quot;&gt;■&lt;/font&gt; MOD03 · Gestão e acompanhamento&lt;br&gt;&lt;font color=&quot;#d6b656&quot;&gt;■&lt;/font&gt; MOD04 · Defesa e agenda&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;■&lt;/font&gt; MOD05 · Publicação&lt;br&gt;&lt;br&gt;Só tabelas e colunas que já existem nas migrações 0001 a 0004." style="text;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#999999;rounded=1;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2455" y="70" width="380" height="250" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>